{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadAloud",
  "version": "0.2.0",
  "identifier": "app.readaloud.reader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReadAloud",
        "width": 1320,
        "height": 900,
        "minWidth": 920,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https: http://localhost:8787; media-src 'self' blob: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A calm document listening companion",
    "longDescription": "Import books and documents, follow sentence-synchronised captions, and listen with system or configured neural voices.",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
